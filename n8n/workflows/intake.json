    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Picks a category from keywords in the title and description (Code node, Run Once for Each Item).\n// Rules are checked top to bottom and the first match wins; nothing matches -> 'Other'.\n// A keyword matches the start of a whole word, so 'report' also matches 'reports' and\n// 'reporting', but 'role' does not match 'control'.\n// ponytail: keyword rules; swap in an AI classifier node if free-text accuracy ever matters.\nconst RULES = [\n  { category: 'Access Request', keywords: ['access', 'permission', 'login', 'password', 'role'] },\n  { category: 'New Automation', keywords: ['automat', 'workflow', 'bot'] },\n  { category: 'Data Fix',       keywords: ['fix', 'wrong', 'incorrect', 'correct', 'missing', 'duplicate'] },\n  { category: 'Report Request', keywords: ['report', 'dashboard', 'export', 'kpi', 'chart'] },\n];\n\nconst request = $json.request;\n\nconst words = `${request.title} ${request.description}`\n  .toLowerCase()\n  .split(/[^a-z0-9]+/)\n  .filter(Boolean);\n\nconst rule = RULES.find((r) => r.keywords.some((k) => words.some((w) => w.startsWith(k))));\n\nreturn { json: { ...request, category: rule ? rule.category : 'Other' } };\n"
      },
