    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Validates one submitted request (Code node, mode: Run Once for Each Item).\n// Returns the cleaned-up fields plus `valid` and `errors`, so the next node can branch.\n// Limits match the CHECK constraints in db/init/02_schema.sql.\nconst DEPARTMENTS = ['Finance', 'IT', 'HR', 'Operations', 'Sales', 'Legal'];\nconst PRIORITIES  = ['P1', 'P2', 'P3', 'P4'];\n\nconst body = $json.body ?? {};\nconst text = (value) => (typeof value === 'string' ? value.trim() : '');\n\nconst request = {\n  requester_name:    text(body.requester_name),\n  requester_email:   text(body.requester_email).toLowerCase(),\n  department:        text(body.department),\n  title:             text(body.title),\n  description:       text(body.description),\n  declared_priority: text(body.declared_priority).toUpperCase(),\n};\n\nconst errors = [];\n// [...s].length counts characters the same way Postgres char_length() does.\nconst checkLength = (field, min, max) => {\n  const length = [...request[field]].length;\n  if (length < min || length > max) {\n    errors.push({ field, message: `must be between ${min} and ${max} characters` });\n  }\n};\n\ncheckLength('requester_name', 2, 100);\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(request.requester_email)) {\n  errors.push({ field: 'requester_email', message: 'must be a valid email address' });\n}\nif (!DEPARTMENTS.includes(request.department)) {\n  errors.push({ field: 'department', message: `must be one of: ${DEPARTMENTS.join(', ')}` });\n}\ncheckLength('title', 5, 150);\ncheckLength('description', 10, 5000);\nif (!PRIORITIES.includes(request.declared_priority)) {\n  errors.push({ field: 'declared_priority', message: `must be one of: ${PRIORITIES.join(', ')}` });\n}\n\nreturn { json: { valid: errors.length === 0, errors, request } };\n"
      },
